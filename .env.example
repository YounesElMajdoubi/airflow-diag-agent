# Copier en .env (make env le fait) puis renseigner les clés d'API.

# --- Clés des fournisseurs de modèles (au moins une ; sans clé, seul le modèle local marche)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# --- Passerelle LiteLLM (clé maître choisie librement, doit commencer par sk-)
LITELLM_MASTER_KEY=sk-diag-local-1234

# --- Airflow
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_READER_PASSWORD=lecture-seule-a-changer
AIRFLOW_JWT_SECRET=change-me-jwt-secret

# --- Entrepôt
ENTREPOT_ADMIN_PASSWORD=postgres-admin-a-changer

# --- Secrets CANARIS du pipeline cobaye. Ce ne sont PAS de vrais secrets : on vérifie
# qu'ils n'atteignent jamais un modèle (métrique fuites_secrets). Garder des valeurs
# longues et uniques (≥ 8 caractères) pour que la détection soit fiable.
ENTREPOT_PASSWORD=cnry-pg-3f9a1c7e2b
FOURNISSEUR_API_KEY=fk_live_9c2e5a7f1b3d4e6a8c0b2d4f6a8e0c1d

# --- Modèle local (seulement avec `make up-local`)
OLLAMA_VERSION=latest
OLLAMA_MODEL=qwen2.5:7b-instruct
# Ollama installé hors Docker (ex. Ollama pour Windows avec le GPU) : décommenter
# OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Accès depuis la machine hôte (scripts make)
AIRFLOW_API_URL=http://localhost:8080
FOURNISSEUR_ADMIN_URL=http://localhost:8000
LITELLM_URL=http://localhost:4000
MLFLOW_TRACKING_URI=http://localhost:5000
